# --- Home Assistant connection ---
HA_URL=http://homeassistant.local:8123
HA_TOKEN=YOUR_LONG_LIVED_ACCESS_TOKEN
PYTHONPATH=/path/to/hass-mcp

# --- Hermes fork: capability flags (which tool groups register) ---
# Defaults shown. Read-only posture = control + prompts OFF.
HASS_MCP_ENABLE_READ=true
HASS_MCP_ENABLE_HISTORY=true
HASS_MCP_ENABLE_DIAGNOSTICS=true
HASS_MCP_ENABLE_RESOURCES=true
HASS_MCP_ENABLE_CONTROL=false
HASS_MCP_ENABLE_PROMPTS=false

# --- Hermes fork: entity allowlist (fail-closed; empty = deny all) ---
# Comma-separated entity_ids and/or fnmatch globs. Independent of HA Assist exposure.
HASS_MCP_ALLOWLIST=sensor.gpu_*,sensor.*_temperature,binary_sensor.*_offline
# Optional: path to a file with one pattern per line (merged with the above; supports # comments)
# HASS_MCP_ALLOWLIST_FILE=/data/allowlist.txt
